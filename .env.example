# TEMPLATE. Copy this file to a file named exactly  .env  in the project folder (next to start.bat) and fill in your
# real values there. The app reads <project>/.env at start-up, so the settings survive restarts, VS Code F5 and
# start.bat. A variable already set in your shell wins over the file; empty values are ignored.
# .env is git-ignored: real passwords go ONLY in .env, never in this template and never in Git.
# Path of the file can be changed with SOC_ENV_FILE.

# ---- Wazuh Indexer (required: no built-in default password) ----
SOC_INDEXER_URL=https://192.168.56.101:9200
SOC_INDEXER_USER=admin
SOC_INDEXER_PASS=change-me

# TLS verification is enabled by default. For an isolated lab with self-signed certificates only,
# explicitly set the relevant *_VERIFY_TLS variable to false. Prefer SOC_CA_BUNDLE for a trusted lab CA.
# Accepted values: true/false (also 1/0, yes/no, on/off). An empty or unrecognised value keeps verification ON.
SOC_CA_BUNDLE=
SOC_VERIFY_TLS=true

# ---- Login (first-start admin account) ----
SOC_ADMIN_EMAIL=admin@example.com
# Must meet the password rules (10-128 characters, not your email, not too simple). Never printed. If empty, a random
# password is shown on an interactive terminal only; otherwise set one with: python backend/manage.py reset-password <email>
SOC_UI_PASSWORD=
SOC_SECRET_KEY=
# Set true once the app is served over HTTPS; keep false for local http://127.0.0.1 development.
SOC_COOKIE_SECURE=false
# Number of reverse proxies in front of the app (Nginx/Caddy = 1). 0 = reached directly (X-Forwarded-For is ignored).
SOC_PROXY_HOPS=0

# ---- Block IP via Wazuh Active Response (optional; dry run by default) ----
SOC_AR_DRY_RUN=true
SOC_WAZUH_API_URL=https://192.168.56.101:55000
SOC_WAZUH_API_USER=wazuh-wui
SOC_WAZUH_API_PASS=
SOC_WAZUH_VERIFY_TLS=true
SOC_AR_AGENT_ID=001
SOC_AR_COMMAND=!firewall-drop
SOC_AR_UNBLOCK_COMMAND=

# ---- Storage and server (optional, sensible defaults already in config.py) ----
SOC_DB_FILE=
SOC_HOST=127.0.0.1
SOC_PORT=5000
